# Self-serve signups (/join) commit to the repo. Without these, POST /api/join
# answers 503 "not configured" and the rest of the site works as normal.
#
# Create a fine-grained personal access token scoped to THIS repository only,
# with Repository permissions -> Contents: Read and write. Nothing else.
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
# Optional; defaults to main.
GITHUB_BRANCH=main
